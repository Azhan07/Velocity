    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.10.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
